# Copy to .streamlit/secrets.toml for Streamlit Cloud (paste the same values into the app's Secrets box).
# Never commit the real secrets.toml.
ANTHROPIC_API_KEY = "sk-ant-..."
GCP_PROJECT_ID = "analyst-agent-512103"
MAX_RUNS_PER_DAY = "20"

[gcp_service_account]
# Paste every field from gcp-key.json here, e.g.
type = "service_account"
project_id = "analyst-agent-512103"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "analyst-agent-app@analyst-agent-512103.iam.gserviceaccount.com"
client_id = "..."
token_uri = "https://oauth2.googleapis.com/token"
